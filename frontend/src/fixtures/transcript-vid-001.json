  "text": "and formulated in the USA."
 },
 {
  "start": 43.52,
  "end": 46.38,
  "text": "You get a treatment plan designed by a doctor"
 },
 {
  "start": 46.38,
  "end": 49.07,
  "text": "to fit your body, goals, and lifestyle."
 },
 {
  "start": 49.07,
  "end": 51.27,
  "text": "You deserve to feel great in your body."
 },
 {
  "start": 51.27,
