[
 {
  "start": 0.24,
  "end": 3.12,
  "text": "Obesity is America's deadliest epidemic."
 },
 {
  "start": 3.12,
  "end": 4.41,
  "text": "This is America."
 },
 {
  "start": 4.41,
  "end": 6.46,
  "text": "74% of us are overweight,"
 },
 {
  "start": 6.46,
  "end": 9.99,
  "text": "and obesity leads to half a million deaths each year."
 },
 {
  "start": 9.99,
  "end": 11.82,
  "text": "- Well, you just have to stop eating, Jimmy."
 },
 {
  "start": 11.82,
  "end": 12.65,
  "text": "This is America."
 },
 {
  "start": 12.65,
  "end": 14.97,
  "text": "Something's broken, and it's not our bodies."
 },
 {
  "start": 14.97,
