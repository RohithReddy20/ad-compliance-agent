  "text": "- Like and subscribe."
 },
 {
  "start": 19.05,
  "end": 20.96,
  "text": "A $160 billion industry"
 },
 {
  "start": 20.96,
  "end": 23.05,
  "text": "that feeds on our failure."
 },
 {
  "start": 23.05,
  "end": 25.17,
  "text": "There are medications that work,"
 },
 {
  "start": 25.17,
  "end": 27.75,
  "text": "but they're priced for profits, not patients."
 },
 {
  "start": 27.75,
  "end": 28.58,
  "text": "This is America."
 },
 {
  "start": 28.58,
  "end": 30.21,
  "text": "This system wasn't built to help us."
 },
 {
  "start": 30.21,
  "end": 33.02,
  "text": "It was built to keep us sick and stuck."
 },
 {
  "start": 33.02,
  "end": 35.25,
  "text": "But not anymore."
 },
 {
  "start": 35.25,
  "end": 38.89,
  "text": "Hims & Hers offers life-changing weight loss medications."
 },
 {
  "start": 38.89,
  "end": 41.73,
  "text": "They're affordable, doctor trusted,"
 },
 {
  "start": 41.73,
